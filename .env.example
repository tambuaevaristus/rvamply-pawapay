# =========================================
# RyvamplyPawapay - Environment Configuration
# =========================================

# PawaPay API
# Generate API tokens from https://dashboard.sandbox.pawapay.io (sandbox)
# or https://dashboard.pawapay.io (production) under System Config > API Tokens
# These keys are used as defaults for all installations (no need to configure via /connect page)
PAWAPAY_API_KEY=pp_api_your_test_token_here
PAWAPAY_LIVE_API_KEY=pp_api_your_live_token_here
PAWAPAY_ENVIRONMENT=sandbox

# GoHighLevel Marketplace Integration
# Create a Marketplace App at https://marketplace.gohighlevel.com to get these
GHL_CLIENT_ID=your_ghl_client_id_here
GHL_CLIENT_SECRET=your_ghl_client_secret_here
GHL_SSO_KEY=your_ghl_sso_key_here
# Must match exactly what's configured in GHL Marketplace App > Redirect URL (no trailing slash)
GHL_REDIRECT_URI=https://rvamply-pawapay-eight.vercel.app/api/pawa/oauth/callback

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data directory (defaults to .data/ locally, /tmp/.data on Vercel)
# DATA_DIR=/tmp/.data
