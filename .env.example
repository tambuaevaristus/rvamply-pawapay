# =========================================
# RyvamplyPawapay - Environment Configuration
# =========================================

# PawaPay API
# Generate an API token from https://dashboard.sandbox.pawapay.io (sandbox)
# or https://dashboard.pawapay.io (production) under System Config > API Tokens
PAWAPAY_API_KEY=pp_api_your_token_here
PAWAPAY_ENVIRONMENT=sandbox

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
